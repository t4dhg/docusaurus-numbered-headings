{
  "name": "docusaurus-numbered-headings",
  "version": "2.0.0",
  "description": "A Docusaurus plugin that automatically adds numbered headings with support for ISO 2145 and USA Classic numbering conventions",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "lib",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "MIGRATION.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test test/*.test.cjs",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "docusaurus",
    "plugin",
    "headings",
    "numbered",
    "documentation",
    "css",
    "markdown",
    "numbering",
    "iso-2145",
    "usa-classic",
    "outline",
    "table-of-contents",
    "toc",
    "hierarchy"
  ],
  "author": "Taig Mac Carthy",
  "license": "MIT",
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "20.19.43",
    "postcss": "8.5.6",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4dhg/docusaurus-numbered-headings.git"
  },
  "bugs": {
    "url": "https://github.com/t4dhg/docusaurus-numbered-headings/issues"
  },
  "homepage": "https://github.com/t4dhg/docusaurus-numbered-headings#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
